      "fileSha256": "f2625e11c8f95f45246b365aaa3d8609111e1e22d1d6a3ad7987136e7d9515a8",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "OPENAI_API_KEY",
